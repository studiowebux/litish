#!/bin/bash
FLAKE="github:studiowebux/litish"
DEV_DIR="/Volumes/studiowebux/Development"

# Hand the dev-dir to the flake at runtime so the published GitHub flake honors
# this machine's volume without needing a local clone or edits.
export LITISH_DEV_DIR="$DEV_DIR"

shell="${1:-all}"

case "$shell" in
  all)    nix develop "$FLAKE" --profile "$DEV_DIR/.dev-profiles/all" ;;
  update) nix flake metadata "$FLAKE" --refresh && echo "Flake refreshed." ;;
  show)   nix flake show "$FLAKE" ;;
  check)  nix flake check "$FLAKE" ;;
  gc)     nix store gc ;;
  *)      nix develop "$FLAKE#$shell" --profile "$DEV_DIR/.dev-profiles/$shell" ;;
esac
